Exec=onyxsh %F
Icon=io.github.vagnarok.OnyxSH
Terminal=false
Categories=System;TerminalEmulator;GTK;
Keywords=terminal;shell;prompt;command;commandline;ssh;sftp;ai;chat;
StartupNotify=true
Actions=NewWindow;

